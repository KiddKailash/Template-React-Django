# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── Frontend URL (used in email deep links) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Initial Users (created by `manage.py seed_users`) ─────────────────────────
# Format: username:password,username2:password2
INITIAL_USERS=

# ── Email (Gmail SMTP with App Password) ──────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Monitoring (optional) ─────────────────────────────────────────────────────
HEALTHCHECK_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# ── !! Leave DB_NAME empty to use SQLite3 loclocally in development environment
DB_NAME=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ── Chroma (optional — remove if not using RAG) ───────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── OpenRouter / LLM harness ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REQUEST_TIMEOUT=60
# Attribution headers (show up on the OpenRouter dashboard).
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Template Django React
# Model IDs referred to by the codebase as "default" / "heavy".
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_HEAVY_MODEL=anthropic/claude-sonnet-4.5
# Monthly USD cap across every AgentRun. 0 disables the cap.
OPENROUTER_MONTHLY_USD_CAP=0
# Max tool-use turns per LLM call before we force a final no-tools turn.
LLM_MAX_TOOL_TURNS=10
# Set to true to skip boot-time AST validation of the tool registry
# (only for tests that mock the registry).
LLM_TOOLS_SKIP_VALIDATION=false

# ── MCP server ────────────────────────────────────────────────────────────────
# Kill switch. When false, /api/mcp/ returns 503 without touching the tool registry.
MCP_ENABLED=true
