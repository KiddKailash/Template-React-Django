# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (ignored while DJANGO_DEBUG=true): TLS terminates in front of
# the app (HSTS, Secure cookies, https redirect). false ONLY for a plain-HTTP
# LAN deployment.
DJANGO_BEHIND_TLS=true
# Proxies whose X-Forwarded-For entries Django trusts for the client IP (DRF
# throttles). nginx resolves the real client itself (real_ip in
# nginx/default.conf) and appends it, so this stays 1 whatever is in front.
DRF_NUM_PROXIES=1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── Frontend URL (used in email deep links) ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Initial Users (created by `manage.py seed_users`) ─────────────────────────
# Format: username:password,username2:password2
INITIAL_USERS=

# ── Email (Gmail SMTP with App Password) ──────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Monitoring (optional) ─────────────────────────────────────────────────────
HEALTHCHECK_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# ── !! Leave DB_NAME empty to use SQLite3 loclocally in development environment
DB_NAME=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ── Chroma (only if enabled: see README "Chroma for RAG") ───────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Web Push (optional; empty = push off, notifications go by email) ─────────
# Generate a pair: uv run python manage.py gen_vapid_keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# A contact push services can reach about this sender (RFC 8292).
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
