# ─────────────────────────────────────────────────────────────────────────────
#  Root .env — what `docker compose` INTERPOLATES into docker-compose.yml.
#
#  Copy to `.env` for local development:      cp .env.example .env
#
#  This is NOT the app's configuration. Django reads `backend/.env` (loaded via
#  `env_file:`), and Compose never interpolates from an `env_file:` — only from
#  this root file, or the shell. So anything written as ${VAR} inside
#  docker-compose.yml has to live here.
#
#  ON THE DEPLOY BOX this file is not used: deploy.yml builds it on every run by
#  layering `backend/.env` + the ROOT_ENV secret + `~/deploy/<project>.env`.
#  Nothing you write here reaches production.
# ─────────────────────────────────────────────────────────────────────────────

# Host port the nginx container publishes. REQUIRED — docker-compose.yml uses
# `:?` so a missing value aborts with a message instead of silently picking one.
# Any free port is fine locally; on a shared host it must be allocated
# deliberately (on pi-zone: the port table in ~/CLAUDE.md, and the value comes
# from ~/deploy/<project>.env rather than from here).
NGINX_HOST_PORT=8080

# Tag for the backend image. REQUIRED, and also `:?`. In CI it is a content
# hash of the dependency manifests, which is what lets the workflow skip a
# rebuild when nothing changed. Locally any constant works — `docker compose
# up --build` will build and tag it.
BACKEND_IMAGE_HASH=dev

# Postgres bootstrap values. The `db` service reads these on FIRST START only —
# changing them later does not re-provision an existing volume. They must match
# DB_NAME / DB_USER / DB_PASSWORD in backend/.env or the backend cannot
# authenticate.
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
